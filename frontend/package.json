{
  "name": "unicode-inference-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare:wasm": "node scripts/prepare-wasm.mjs",
    "build:wasm": "node scripts/prepare-wasm.mjs --build",
    "predev": "npm run prepare:wasm",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run prepare:wasm",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:browser": "npm run build && playwright test",
    "format": "prettier --write src scripts test *.ts *.json index.html README.md",
    "format:check": "prettier --check src scripts test *.ts *.json index.html README.md"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "0.4.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.0",
    "@mdit/plugin-katex": "1.2.0",
    "@uiw/react-codemirror": "4.25.12",
    "katex": "0.19.1",
    "markdown-it": "15.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.3.0",
    "prettier": "3.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "8.3.8"
  }
}
